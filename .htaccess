# ============================================
# UPTEC Cursos - Configuración Apache & Redirecciones
# Compatible tanto con subcarpeta (/uptec-cursos/) como con VirtualHost raíz
# ============================================

Options -Indexes +FollowSymLinks
DirectoryIndex index.php frontend/index.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Si el archivo o directorio solicitado existe físicamente, servirlo directamente
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 2. Servir internamente recursos estáticos si se piden directamente
    RewriteRule ^frontend/(css|js|img)/(.*)$ frontend/$1/$2 [L]
    RewriteRule ^(css|js|img)/(.*)$ frontend/$1/$2 [L]

    # 3. Redirección de URLs cortas hacia las vistas físicas reales para preservar rutas relativas de CSS/JS
    RewriteRule ^(administrador|analista|facilitador|participante)/?$ frontend/views/$1/dashboard.html [R=302,L]
    RewriteRule ^views/(administrador|analista|facilitador|participante)/?$ frontend/views/$1/dashboard.html [R=302,L]
    RewriteRule ^(administrador|analista|facilitador|participante)/([a-zA-Z0-9_-]+)\.html$ frontend/views/$1/$2.html [R=302,L]
    RewriteRule ^(administrador|analista|facilitador|participante)/([a-zA-Z0-9_-]+)$ frontend/views/$1/$2.html [R=302,L]
    RewriteRule ^views/(.*)$ frontend/views/$1 [R=302,L]

    # 4. Rutas base
    RewriteRule ^$ frontend/index.html [L]
    RewriteRule ^index(\.html)?$ frontend/index.html [L]
    RewriteRule ^login(\.html)?$ frontend/login.html [L]
</IfModule>

# --------------------------------------------
# 5. Seguridad
# --------------------------------------------
<FilesMatch "(^\.|\.(sql|env|ini|log|lnk|sh|bat|md)$)">
    Require all denied
</FilesMatch>

RedirectMatch 404 /\.git

# --------------------------------------------
# 6. Cabeceras de seguridad
# --------------------------------------------
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
